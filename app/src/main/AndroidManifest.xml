<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-feature android:name="android.hardware.camera.any" android:required="true" />
    <uses-feature android:name="android.hardware.sensor.hinge_angle" android:required="false" />
    <queries>
        <package android:name="app.thetahatch.home" />
        <package android:name="app.thetahatch.kidshome" />
        <intent><action android:name="android.intent.action.VIEW" /><data android:scheme="https" /></intent>
        <intent><action android:name="android.speech.RecognitionService" /></intent>
    </queries>
    <!-- シリーズ共通の鍵で署名したアプリ同士だけが使える（spec/THETA_SHARED_SETTINGS.md §4） -->
    <permission android:name="app.thetahatch.permission.SHARE" android:protectionLevel="signature" />
    <application android:theme="@style/AppTheme" android:label="Theta Camera Hatch" android:icon="@drawable/ic_launcher" android:allowBackup="false" android:supportsRtl="true">
        <activity android:name=".MainActivity" android:exported="true" android:resizeableActivity="true" android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|density">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity>
        <!-- 撮って返す（spec/THETA_HATCH_SPEC.md §6.2 CAPTURE）。データを返すので共通鍵の権限で守る -->
        <activity-alias android:name=".CaptureActivity" android:targetActivity=".MainActivity" android:exported="true" android:permission="app.thetahatch.permission.SHARE">
            <intent-filter>
                <action android:name="app.thetahatch.action.CAPTURE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>
        <provider android:name="androidx.core.content.FileProvider" android:authorities="${applicationId}.files" android:exported="false" android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/capture_paths" />
        </provider>
        <!-- ADB の窓口（シリーズ共通 spec/THETA_ADB_SPEC.md）。DUMP 権限で adb のシェルからだけ -->
        <service android:name="app.thetahatch.adb.StatusService" android:exported="true" android:permission="android.permission.DUMP" />
        <receiver android:name="app.thetahatch.adb.CommandReceiver" android:exported="true" android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="app.thetahatch.adb.STATUS" />
                <action android:name="app.thetahatch.adb.GET" />
                <action android:name="app.thetahatch.adb.SET" />
                <action android:name="app.thetahatch.adb.OPEN" />
                <action android:name="app.thetahatch.adb.CHECK_UPDATE" />
                <action android:name="app.thetahatch.adb.PHOTO" />
                <action android:name="app.thetahatch.adb.BURST" />
                <action android:name="app.thetahatch.adb.VIDEO" />
                <action android:name="app.thetahatch.adb.ZOOM" />
                <action android:name="app.thetahatch.adb.FACING" />
                <action android:name="app.thetahatch.adb.MODE" />
                <action android:name="app.thetahatch.adb.FPS" />
                <action android:name="app.thetahatch.adb.ASPECT" />
                <action android:name="app.thetahatch.adb.EV" />
                <action android:name="app.thetahatch.adb.FLASH" />
                <action android:name="app.thetahatch.adb.TIMER" />
                <action android:name="app.thetahatch.adb.HUD" />
                <action android:name="app.thetahatch.adb.FOLDER" />
                <action android:name="app.thetahatch.adb.EVENT" />
                <action android:name="app.thetahatch.adb.VOICE" />
                <action android:name="app.thetahatch.adb.COVER" />
                <action android:name="app.thetahatch.adb.REAR" />
                <action android:name="app.thetahatch.adb.REBIND" />
                <action android:name="app.thetahatch.adb.DIAG" />
            </intent-filter>
        </receiver>
    </application>
</manifest>